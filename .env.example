# ─── APPLICATION ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── DATABASE ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthcare_db

# ─── AUTHENTICATION (Milestone 2) ────────────────────────────────────────────
JWT_SECRET=replace-with-a-secure-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_ROUNDS=12

# ─── EMAIL (Milestone 8) ─────────────────────────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@healthcare-app.com

# ─── LLM (Milestone 5) ───────────────────────────────────────────────────────
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2

# ─── GOOGLE CALENDAR (Milestone 10) ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/calendar/callback
CALENDAR_TOKEN_ENCRYPTION_KEY=

# ─── BOOKING ─────────────────────────────────────────────────────────────────
SLOT_HOLD_DURATION_MINUTES=5
DEFAULT_CONSULTATION_DURATION_MIN=30

# ─── NOTIFICATIONS ───────────────────────────────────────────────────────────
NOTIFICATION_MAX_RETRIES=3
APPOINTMENT_REMINDER_HOURS_BEFORE=24
