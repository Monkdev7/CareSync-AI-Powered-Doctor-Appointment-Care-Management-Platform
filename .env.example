# ─── APPLICATION ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── DATABASE ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthcare_db

# ─── AUTHENTICATION ──────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-secure-random-string-at-least-16-chars
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12

# ─── EMAIL (Nodemailer SMTP) ─────────────────────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@healthcare-app.com

# ─── LLM ─────────────────────────────────────────────────────────────────────
# Provider: mock | openai
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2

# ─── GOOGLE CALENDAR ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/calendar/callback
CALENDAR_TOKEN_ENCRYPTION_KEY=

# ─── BOOKING ─────────────────────────────────────────────────────────────────
SLOT_HOLD_DURATION_MINUTES=5
DEFAULT_CONSULTATION_DURATION_MIN=30

# ─── NOTIFICATIONS ───────────────────────────────────────────────────────────
NOTIFICATION_MAX_RETRIES=3
APPOINTMENT_REMINDER_HOURS_BEFORE=24
